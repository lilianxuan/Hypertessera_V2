# BNB Smart Chain mainnet — template. Copy to bsc-mainnet.env and fill in every value.
#
#   cp script/deploy/networks/bsc-mainnet.env.example script/deploy/networks/bsc-mainnet.env
#   $EDITOR script/deploy/networks/bsc-mainnet.env
#   ./script/deploy.sh --network bsc-mainnet --dry-run     # simulate stage 1 first
#   ./script/deploy.sh --network bsc-mainnet
#
# Under DEPLOY_PROFILE=production nothing falls back to the deploy wallet: every variable below is
# mandatory and the deploy aborts naming any one that is missing. No mock token and no demo asset
# is deployed. Read docs/deployment-handbook.md before running this.

RPC_URL=https://bsc-dataseed.binance.org
DEPLOY_PROFILE=production
FORGE_FLAGS="--legacy --slow"

# The real settlement token. On BNB Chain mainnet, USDT is 0x55d398326f99059fF775485246999027B3197955.
USDT=

# Vault-local roles. See docs/deployment-handbook.md for what each one may do.
VAULT_CURATOR=
VAULT_KEEPER=
VAULT_GUARDIAN=
VAULT_ALLOCATOR=

# Settlement operator set, shared by all three Vaults. SETTLEMENT_THRESHOLD is how many of them
# must sign a settlement; it must be between 1 and the number of operators listed.
SETTLEMENT_OPERATORS=
SETTLEMENT_THRESHOLD=

# Per-Adapter deal-data signer.
DATA_PROVIDER_SIGNER=

# Seconds after a claim is due before it may be recorded as overdue. Defaults to 30 days.
# CLAIM_GRACE_PERIOD=2592000
