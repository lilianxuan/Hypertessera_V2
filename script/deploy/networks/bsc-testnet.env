# BNB Smart Chain Testnet (chainId 97).
#
#   ./script/deploy.sh --network bsc-testnet
#
# The deploy key comes from TEST_PK or PRIVATE_KEY in the repo .env — it is deliberately NOT
# stored here, so this file is safe to commit.

RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
DEPLOY_PROFILE=demo

# BSC Testnet does not price EIP-1559 transactions reliably; --legacy keeps every transaction on
# the legacy gas path. --slow serialises the broadcast, which this RPC needs: its load balancer
# occasionally rejects a correctly-nonced transaction with `nonce too low` when they arrive
# together.
FORGE_FLAGS="--legacy --slow"

# Carrying an existing Mock USDT across a redeploy keeps the test wallets' balances instead of
# zeroing them for a new generation. Comment out to mint a fresh one.
USDT=0xF7611799e16E5fFcAA00dBA882DB6e73F0731921

# Leave the role variables unset to run single-wallet (every role resolves to the deploy wallet),
# which is how the testnet generations have been deployed. Set any of them to split the roles:
#
# VAULT_CURATOR=0x...
# VAULT_KEEPER=0x...
# VAULT_GUARDIAN=0x...
# VAULT_ALLOCATOR=0x...
# SETTLEMENT_OPERATORS=0x...,0x...
# SETTLEMENT_THRESHOLD=2
# DATA_PROVIDER_SIGNER=0x...
