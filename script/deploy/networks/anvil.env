# Local Anvil devnet.
#
#   anvil --port 8545
#   ./script/deploy.sh --network anvil
#
# Everything is left at its demo default: Mock USDT is minted fresh, the two demo assets are
# registered, and every role falls back to a deterministic Anvil account.

RPC_URL=http://127.0.0.1:8545
DEPLOY_PROFILE=demo

# --slow sends each transaction only after the previous one is confirmed. Without it forge fires
# the whole batch at once and Anvil occasionally never mines one, leaving forge blocked in
# wait_for_pending on a receipt that never arrives.
FORGE_FLAGS="--slow"
